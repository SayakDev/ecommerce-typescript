# Node.js dependencies
node_modules/

# Compiled output (TypeScript build)
#dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*    # if you use multiple env files like .env.development, .env.production

# IDE & editor folders
.vscode/
.idea/

# OS-specific junk files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo

# TypeScript cache and build artifacts
*.tsbuildinfo

# Coverage reports (if using Jest or other test tools)
coverage/
